# ---- Bắt buộc ----
# Chuỗi kết nối PostgreSQL (ASP.NET đọc biến môi trường với dấu __ thay cho :)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=drinkwater;Username=postgres;Password=<mật-khẩu-của-bạn>

# Khoá ký JWT — tối thiểu 32 ký tự, đổi khi chạy thật
# Tạo khoá riêng: mở PowerShell chạy  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 56 | % {[char]})
Jwt__Key=<chuỗi ngẫu nhiên >= 32 ký tự>

# Mật khẩu tài khoản admin seed lần đầu
App__SeedAdmin__Password=<mật khẩu admin mạnh, tự đặt>

# ---- Tuỳ chọn ----
ASPNETCORE_URLS=http://127.0.0.1:5157
ASPNETCORE_ENVIRONMENT=Development
App__TimeZone=Asia/Ho_Chi_Minh

# Tách nền ảnh cốc bằng rembg sidecar (để trống/Enabled=false nếu không dùng)
Rembg__Enabled=true
Rembg__Url=http://127.0.0.1:7000
Rembg__Model=birefnet-general

# Lưu ảnh: Local | (mở rộng) S3/Firebase
Storage__Provider=Local
Storage__MaxBytes=5242880
# Web Push (VAPID) - bat de nhac uong nuoc khi app da dong
# Tao cap khoa: npx web-push generate-vapid-keys
WebPush__Enabled=true
WebPush__Subject=mailto:you@example.com
WebPush__PublicKey=
WebPush__PrivateKey=