{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "DrinkWater",
    "Audience": "DrinkWaterClient",
    "Key": "",
    "ExpireHours": 720
  },
  "App": {
    "TimeZone": "Asia/Ho_Chi_Minh",
    "SeedAdmin": {
      "Email": "admin@drinkwater.local",
      "Password": "",
      "FullName": "Administrator"
    }
  },
  "Storage": {
    "Provider": "Local",
    "MaxBytes": 5242880
  },
  "WebPush": {
    "Enabled": true,
    "Subject": "mailto:admin@drinkwater.local",
    "PublicKey": "",
    "PrivateKey": ""
  },
  "Rembg": {
    "Enabled": true,
    "Url": "http://127.0.0.1:7000",
    "Model": "isnet-general-use",
    "DecontaminateEdges": true,
    "TimeoutSeconds": 180
  }
}
